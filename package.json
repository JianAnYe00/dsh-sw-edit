{
  "name": "dsh-sw-edit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Feature-tree editing for SolidWorks (list / suppress / delete / save) as a DeepSeek Harness bundle.",
  "os": [
    "win32"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "driver/Program.cs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "solidworks",
    "feature-tree"
  ],
  "homepage": "https://github.com/JianAnYe00/dsh-sw-edit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JianAnYe00/dsh-sw-edit.git"
  },
  "bugs": {
    "url": "https://github.com/JianAnYe00/dsh-sw-edit/issues"
  },
  "license": "MIT"
}
